# This file is a safe overview of the local configuration.
# The authoritative examples are client/.env.example and server/.env.example.

# Client (client/.env)
VITE_API_BASE=http://localhost:4000

# Server (server/.env)
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/lor_management
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_IN=7d
CLIENT_BASE_URL=http://localhost:5173
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
RESET_TOKEN_TTL_MINUTES=15
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LOR Portal <no-reply@example.com>
RESEND_API_KEY=
RESEND_FROM=LOR Portal <no-reply@example.com>
EMAIL_MONTHLY_CAP=30
